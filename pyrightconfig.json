{
  // Checks the app's Python; the bundled engine is resolved but not checked.
  "include": ["backend/dazedtl", "tests", "scripts"],
  "exclude": ["backend/dazedtl/engine", "**/__pycache__"],
  "extraPaths": ["backend", "backend/dazedtl/engine"],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {
      // Tests use monkeypatching and lightweight fakes, and index results
      // they have just asserted exist; other checks still apply.
      "root": "tests",
      // Discovery runs from the checkout root, so tests import as a package.
      "extraPaths": [".", "backend", "backend/dazedtl/engine"],
      "reportAttributeAccessIssue": "none",
      "reportArgumentType": "none",
      "reportOptionalSubscript": "none",
      "reportOptionalMemberAccess": "none"
    },
    { "root": "backend" },
    { "root": "scripts", "extraPaths": ["backend"] }
  ]
}
